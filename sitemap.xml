---
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign posts = site.posts | where_exp: 'post', 'post.sitemap != false and post.hidden != true' %}
  {% for post in posts %}
    <url>
      <loc>{{ post.url | absolute_url | xml_escape }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.lastmod | default: post.date | date_to_xmlschema }}</lastmod>
    </url>
  {% endfor %}
  {% assign pages = site.html_pages | where_exp: 'page', 'page.sitemap != false' %}
  {% for page in pages %}
    <url>
      <loc>{{ page.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
      {% assign modified = page.last_modified_at | default: page.sitemap.lastmod %}
      {% if modified %}<lastmod>{{ modified | date_to_xmlschema }}</lastmod>{% endif %}
    </url>
  {% endfor %}
  <!-- This generated subsite has no Jekyll front matter, so it is not in site.html_pages. -->
  <url>
    <loc>{{ '/sites/erdos/' | absolute_url | xml_escape }}</loc>
  </url>
  <url>
    <loc>{{ '/sites/erdos/trends/' | absolute_url | xml_escape }}</loc>
  </url>
</urlset>
